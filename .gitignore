# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin
.kotlin/

# Local config
local.properties
*.local

# Node (KMP/JS toolchain + dist). kotlin-js-store/ (the Kotlin/JS yarn.lock) stays untracked on purpose:
# the one npm input that ships, the TLSN prover, is pinned by version + integrity in core/build.gradle.kts.
node_modules/
kotlin-js-store/

# IDE
.idea/
*.iml
.fleet/

# Debug harness — generated bundle (built by `:debug-harness:assembleDebugExtension`)
tools/debug-extension/vendor/

# Debug extension — local-only environment overrides (never commit)
tools/debug-extension/settings.local.js
tools/debug-extension/manifest.local.json

# Downloaded steam-provenance CI artifact tarballs, the pre-npm way to fetch the prover. It now comes from
# npm (see core/PROVER.md); these stay ignored so a stray download is never committed.
client-wasm-*.tgz
client-wasm-*.tgz.sha256
client-wasm-steam-provenance-*/

# OS
.DS_Store

# Logs / secrets
*.log
*.gpg
secring.*

# CI: release vars emitted by core/npm/prepare-package.sh
release.env
