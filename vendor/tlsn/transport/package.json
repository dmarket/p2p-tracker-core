{
  "name": "client-wasm-transport",
  "version": "0.2.0",
  "description": "WebSocket IoChannel transport + injection-based pass-through prover façade for the client-wasm browser-extension prover.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
