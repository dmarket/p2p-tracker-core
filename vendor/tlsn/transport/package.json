    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": ">=5.6.0"
  }
}
